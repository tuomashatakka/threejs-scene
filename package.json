{
  "name": "threejs-scene",
  "version": "0.7.0",
  "description": "Deterministic imperative three.js scenes: a scoped, unidirectional module contract, an LLM-first procedural asset toolkit, fixed-step physics, explicit disposal \u2014 and the instructions, agents and enforced rules shipped inside the package.",
  "type": "module",
  "main": "./dist/cjs/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib/index.d.ts",
        "default": "./dist/lib/index.js"
      },
      "require": {
        "types": "./dist/cjs/lib/index.d.ts",
        "default": "./dist/cjs/lib/index.js"
      }
    },
    "./modules/lighting": {
      "import": {
        "types": "./dist/modules/lighting/index.d.ts",
        "default": "./dist/modules/lighting/index.js"
      },
      "require": {
        "types": "./dist/cjs/modules/lighting/index.d.ts",
        "default": "./dist/cjs/modules/lighting/index.js"
      }
    },
    "./modules/orbit": {
      "import": {
        "types": "./dist/modules/orbit/index.d.ts",
        "default": "./dist/modules/orbit/index.js"
      },
      "require": {
        "types": "./dist/cjs/modules/orbit/index.d.ts",
        "default": "./dist/cjs/modules/orbit/index.js"
      }
    },
    "./modules/post": {
      "import": {
        "types": "./dist/modules/post/index.d.ts",
        "default": "./dist/modules/post/index.js"
      },
      "require": {
        "types": "./dist/cjs/modules/post/index.d.ts",
        "default": "./dist/cjs/modules/post/index.js"
      }
    },
    "./modules/assets": {
      "import": {
        "types": "./dist/modules/assets/index.d.ts",
        "default": "./dist/modules/assets/index.js"
      },
      "require": {
        "types": "./dist/cjs/modules/assets/index.d.ts",
        "default": "./dist/cjs/modules/assets/index.js"
      }
    },
    "./modules/physics": {
      "import": {
        "types": "./dist/modules/physics/index.d.ts",
        "default": "./dist/modules/physics/index.js"
      },
      "require": {
        "types": "./dist/cjs/modules/physics/index.d.ts",
        "default": "./dist/cjs/modules/physics/index.js"
      }
    },
    "./modules/post/webgl": {
      "import": {
        "types": "./dist/modules/post/webgl/index.d.ts",
        "default": "./dist/modules/post/webgl/index.js"
      },
      "require": {
        "types": "./dist/cjs/modules/post/webgl/index.d.ts",
        "default": "./dist/cjs/modules/post/webgl/index.js"
      }
    },
    "./modules/camera": {
      "import": {
        "types": "./dist/modules/camera/index.d.ts",
        "default": "./dist/modules/camera/index.js"
      },
      "require": {
        "types": "./dist/cjs/modules/camera/index.d.ts",
        "default": "./dist/cjs/modules/camera/index.js"
      }
    },
    "./modules/input": {
      "import": {
        "types": "./dist/modules/input/index.d.ts",
        "default": "./dist/modules/input/index.js"
      },
      "require": {
        "types": "./dist/cjs/modules/input/index.d.ts",
        "default": "./dist/cjs/modules/input/index.js"
      }
    },
    "./modules/quality": {
      "import": {
        "types": "./dist/modules/quality/index.d.ts",
        "default": "./dist/modules/quality/index.js"
      },
      "require": {
        "types": "./dist/cjs/modules/quality/index.d.ts",
        "default": "./dist/cjs/modules/quality/index.js"
      }
    },
    "./modules/diagnostics": {
      "import": {
        "types": "./dist/modules/diagnostics/index.d.ts",
        "default": "./dist/modules/diagnostics/index.js"
      },
      "require": {
        "types": "./dist/cjs/modules/diagnostics/index.d.ts",
        "default": "./dist/cjs/modules/diagnostics/index.js"
      }
    },
    "./modules/persistence": {
      "import": {
        "types": "./dist/modules/persistence/index.d.ts",
        "default": "./dist/modules/persistence/index.js"
      },
      "require": {
        "types": "./dist/cjs/modules/persistence/index.d.ts",
        "default": "./dist/cjs/modules/persistence/index.js"
      }
    },
    "./modules/all": {
      "import": {
        "types": "./dist/modules/all/index.d.ts",
        "default": "./dist/modules/all/index.js"
      },
      "require": {
        "types": "./dist/cjs/modules/all/index.d.ts",
        "default": "./dist/cjs/modules/all/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/lib/testing/index.d.ts",
        "default": "./dist/lib/testing/index.js"
      },
      "require": {
        "types": "./dist/cjs/lib/testing/index.d.ts",
        "default": "./dist/cjs/lib/testing/index.js"
      }
    },
    "./llm": {
      "import": {
        "types": "./dist/lib/llm/index.d.ts",
        "default": "./dist/lib/llm/index.js"
      },
      "require": {
        "types": "./dist/cjs/lib/llm/index.d.ts",
        "default": "./dist/cjs/lib/llm/index.js"
      }
    },
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.mjs"
    },
    "./llms.txt": "./llms.txt",
    "./llm/AGENTS.md": "./llm/AGENTS.md",
    "./llm/RULES.md": "./llm/RULES.md",
    "./llm/rules.json": "./llm/rules.json",
    "./llm/modules.json": "./llm/modules.json",
    "./llm/index.json": "./llm/index.json",
    "./modules/*": {
      "import": {
        "types": "./dist/modules/*.d.ts",
        "default": "./dist/modules/*.js"
      },
      "require": {
        "types": "./dist/cjs/modules/*.d.ts",
        "default": "./dist/cjs/modules/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "eslint",
    "llm",
    "llms.txt",
    "readme.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "build:site": "vite build site",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "npm run build && vite site",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build && npm run llms && npm run llm:assets && publint && attw --pack . --exclude-entrypoints llms.txt llm/AGENTS.md llm/RULES.md --ignore-rules cjs-resolves-to-esm",
    "prepare": "npm run build",
    "llms": "bun scripts/gen-llms.ts",
    "llms:check": "bun scripts/gen-llms.ts --check",
    "llm:assets": "bun scripts/gen-llm-assets.ts",
    "llm:assets:check": "bun scripts/gen-llm-assets.ts --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuomashatakka/threejs-scene.git"
  },
  "keywords": [
    "threejs",
    "three",
    "webgl",
    "scene",
    "app-shell",
    "deterministic",
    "frame-loop"
  ],
  "author": "Tuomas Hatakka",
  "license": "ISC",
  "peerDependencies": {
    "cannon-es": ">=0.20.0",
    "three": ">=0.160.0"
  },
  "dependencies": {
    "@tuomashatakka/canvas-loop-framecapper": "^1.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@tuomashatakka/eslint-config": "^4.0.1",
    "@types/three": "^0.184.1",
    "cannon-es": "^0.20.0",
    "eslint": "^10.7.0",
    "publint": "^0.3.12",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://tuomashatakka.github.io/threejs-scene/",
  "bugs": {
    "url": "https://github.com/tuomashatakka/threejs-scene/issues"
  },
  "module": "./dist/lib/index.js",
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/lib/testing/index.d.ts"
      ],
      "llm": [
        "./dist/lib/llm/index.d.ts"
      ],
      "modules/*": [
        "./dist/cjs/modules/*.d.ts",
        "./dist/cjs/modules/*/index.d.ts"
      ]
    }
  },
  "peerDependenciesMeta": {
    "cannon-es": {
      "optional": true
    }
  },
  "bin": {
    "threejs-scene": "./bin/cli.mjs"
  }
}
